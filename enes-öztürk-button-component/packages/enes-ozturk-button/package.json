      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "button",
    "component",
    "ui",
    "ant-design",
    "primary",
    "default",
    "dashed",
    "text",
    "link",
    "enes-ozturk",
    "turkish-developer",
    "design-system"
  ],
  "author": "Enes Öztürk <enesbino38@gmail.com>",
  "homepage": "https://github.com/enesozturk/enes-ozturk-button#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enesozturk/enes-ozturk-button.git"
  },
  "bugs": {
    "url": "https://github.com/enesozturk/enes-ozturk-button/issues"
  },
