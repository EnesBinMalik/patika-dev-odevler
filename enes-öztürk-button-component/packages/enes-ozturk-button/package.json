  "type": "module",
  "description": "Ant Design inspired customizable React Button component supporting primary, default, dashed, text, and link types. Developed by Enes Öztürk.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
